{
  "name": "croit-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for the Nostalgia community",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:once": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commands:deploy": "tsx src/bot/deploy-commands.ts",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:check": "tsx src/database/check-connection.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nos-community/Croit-Bot.git"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "nostalgia"
  ],
  "author": "",
  "bugs": {
    "url": "https://github.com/nos-community/Croit-Bot/issues"
  },
  "homepage": "https://github.com/nos-community/Croit-Bot#readme",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.3",
    "prettier": "^3.9.5",
    "prisma": "^7.9.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
