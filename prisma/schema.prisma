// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  discordId         String        @unique @map("discord_id")
  discordUsername   String?       @map("discord_username")
  eamusementId      String?       @map("eamusement_id")
  baseNickname      String?       @map("base_nickname")
  
  gradeBasic        Int           @default(0) @map("grade_basic")
  gradeRecital      Int           @default(0) @map("grade_recital")
  
  lastGradeUpdateAt DateTime?     @map("last_grade_update_at") @db.Timestamptz(3)
  status            UserStatus    @default(ACTIVE)

  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model AuthRequest {
  id          String    @id @default(uuid()) @db.Uuid
  token       String    @unique
  discordId   String
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  authSession AuthSession?
  
  @@index([token])
}

model AuthSession {
  id            String   @id @default(uuid()) @db.Uuid
  authRequestId String   @unique @db.Uuid
  discordId     String
  sessionToken  String   @unique @map("session_token")

  createdAt     DateTime @default(now())
  expiresAt     DateTime

  authRequest AuthRequest @relation(fields: [authRequestId], references: [id], onDelete: Cascade)

  @@index([discordId])
  @@index([expiresAt])
}

model GradeUpdateRequest {
  id          String   @id @default(uuid()) @db.Uuid
  token       String   @unique
  discordId   String
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([token])
}